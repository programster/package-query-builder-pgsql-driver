{
    "name": "programster/query-builder-pgsql-driver",
    "type": "library",
    "description": "A PostgreSQL driver for the programster/query-builder-parser package, which turns jQuery QueryBuilder's JSON into SQL.",
    "keywords": ["postgresql", "pgsql", "query", "builder", "querybuilder", "sql"],
    "homepage": "https://github.com/programster/package-query-builder-pgsql-driver",
    "license": "MIT",
    "authors": [
        {
            "name": "Stuart Page",
            "email": "sdpagent@gmail.com",
            "homepage": "https://blog.programster.org",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-pgsql": "*",
        "programster/pgsql-lib": "^3.0",
        "programster/query-builder-parser": "^1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "Programster\\QueryBuilderPgsqlDriver\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Programster\\QueryBuilderPgsqlDriver\\Testing\\": "testing/"
        }
    }
}
